# FinGuard - Configuração de Ambiente (Dual Provider: Zup AI Gateway / Ollama Local)
# As variáveis principais do Zup são carregadas do ~/.zshrc.
# Este arquivo serve como fallback e documentação.

# --- Seleção de Provider ---
# "zup" = AI Gateway Zup (Claude Haiku/Sonnet via Bedrock) — default
# "ollama" = Ollama local (modelos open-source, custo zero)
LLM_PROVIDER=zup
# =============================================================================
# PROVIDER: ZUP AI GATEWAY (carregado do shell ~/.zshrc)
# =============================================================================
# KEY_FT=<token>                    # Token de autenticação do LiteLLM proxy
# LITELLM_PROXY_URL= url do provider
# KEY_ALIAS_FT=alias do provider (ex: zup, ollama, etc.)
# BUDGET_FT=qual bugdet de tokens (ex: 1000000) para tracking de custo
# MODEL_HAIKU_FT=  # Modelo leve (triagem)
# MODEL_SONNET_FT= # Modelo robusto (risco/relatório)

# Custos Zup (USD por 1M tokens) — Claude Haiku 4.5 / Sonnet 4.5 via Bedrock
COST_INPUT_LIGHT=0.80
COST_OUTPUT_LIGHT=4.00
COST_INPUT_HEAVY=3.00
COST_OUTPUT_HEAVY=15.00

# =============================================================================
# PROVIDER: OLLAMA LOCAL
# =============================================================================
# OLLAMA_BASE_URL=http://localhost:11434/v1
# OLLAMA_MODEL_LIGHT=qwen2.5:3b      # Modelo leve para triagem
# OLLAMA_MODEL_HEAVY=qwen2.5:3b     # Modelo robusto para risco/relatório

# Custos Ollama = 0.00 (infra local). Mantenha zerados para tracking correto.
# COST_INPUT_LIGHT=0.00
# COST_OUTPUT_LIGHT=0.00
# COST_INPUT_HEAVY=0.00
# COST_OUTPUT_HEAVY=0.00

# =============================================================================
# CAMINHOS E LOGGING
# =============================================================================
DATASET_PATH=../artifacts/dataset_finguard_desafio_3 (4).csv
POLICY_PDF_PATH=../artifacts/KS_POLITICA_INTERNA (4).pdf
LOG_LEVEL=INFO